# Rail Data Marketplace (RDM) Live Darwin Credentials Template
# Copy this file to .env and replace placeholders with your actual RDM credentials from https://raildata.org.uk

RDM_BOOTSTRAP_SERVER=kafka.raildata.org.uk:9092
RDM_TOPIC=Consumer.rdmportal.VirtualTopic.PushPort-v18
RDM_CONSUMER_KEY=YOUR_RDM_CONSUMER_KEY_HERE
RDM_CONSUMER_SECRET=YOUR_RDM_CONSUMER_SECRET_HERE
RDM_SASL_MECHANISM=PLAIN
RDM_SECURITY_PROTOCOL=SASL_SSL

# Local OSC Transport settings
OSC_HOST=127.0.0.1
OSC_PORT=7400
